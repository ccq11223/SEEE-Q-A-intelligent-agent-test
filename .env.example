# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。

# ---------- 云端数据库（Supabase → Project Settings → Database → Connection string → URI）----------
# 形如：postgresql://postgres.xxxxx:数据库口令@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ---------- 视觉解析模型（默认：阿里云百炼 DashScope）----------
# 控制台：https://bailian.console.aliyun.com  → API-KEY 管理
DASHSCOPE_API_KEY=

# ---------- 向量化模型（默认：硅基流动 SiliconFlow 的 BAAI/bge-m3）----------
# 控制台：https://cloud.siliconflow.cn  → API 密钥
SILICONFLOW_API_KEY=

# ---------- 生成模型（默认：DeepSeek）----------
# 控制台：https://platform.deepseek.com  → API keys
DEEPSEEK_API_KEY=

# ---------- 可选：联网兜底搜索（阶段 2 才用到，先留空）----------
TAVILY_API_KEY=
